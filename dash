local DashHandler = {}

local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")

local plr = Players.LocalPlayer

local dashLength = 5
local dashTime = 0.05
local yBoost = 20

local enabled = false

-- 🌈 rainbow animation
local function createRainbowTrail(hrp)
    local att0 = Instance.new("Attachment", hrp)
    local att1 = Instance.new("Attachment", hrp)

    att0.Position = Vector3.new(0, 0, -1)
    att1.Position = Vector3.new(0, 0, 1)

    local trail = Instance.new("Trail")
    trail.Attachment0 = att0
    trail.Attachment1 = att1
    trail.Lifetime = 0.3
    trail.MinLength = 0.1
    trail.FaceCamera = true
    trail.Parent = hrp

    -- màu cầu vồng
    trail.Color = ColorSequence.new{
        ColorSequenceKeypoint.new(0, Color3.fromRGB(255,0,0)),
        ColorSequenceKeypoint.new(0.2, Color3.fromRGB(255,165,0)),
        ColorSequenceKeypoint.new(0.4, Color3.fromRGB(255,255,0)),
        ColorSequenceKeypoint.new(0.6, Color3.fromRGB(0,255,0)),
        ColorSequenceKeypoint.new(0.8, Color3.fromRGB(0,0,255)),
        ColorSequenceKeypoint.new(1, Color3.fromRGB(255,0,255)),
    }

    -- animation chạy màu
    task.spawn(function()
        local t = 0
        while trail and trail.Parent do
            t += 0.02
            trail.Transparency = NumberSequence.new{
                NumberSequenceKeypoint.new(0, math.abs(math.sin(t))),
                NumberSequenceKeypoint.new(1, 1)
            }
            task.wait()
        end
    end)

    return trail, att0, att1
end

function DashHandler.SetLength(v)
    dashLength = v
end

function DashHandler.Toggle(state)
    enabled = state
end

function DashHandler.Dash()
    if not enabled then return end

    local char = plr.Character
    if not char then return end

    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    local bv = Instance.new("BodyVelocity")
    bv.MaxForce = Vector3.new(1e5, 1e5, 1e5)

    local look = hrp.CFrame.LookVector
    local dir = Vector3.new(look.X, 0, look.Z).Unit
    local speed = dashLength / dashTime

    bv.Velocity = (dir * speed) + Vector3.new(0, yBoost, 0)
    bv.Parent = hrp

    -- 🌈 trail
    local trail, a0, a1 = createRainbowTrail(hrp)

    task.wait(dashTime)

    bv:Destroy()

    if trail then trail:Destroy() end
    if a0 then a0:Destroy() end
    if a1 then a1:Destroy() end
end

return DashHandler
